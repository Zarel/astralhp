{
	"useTabs": true,
	"typescript": {
		"operatorPosition": "sameLine",
		"quoteStyle": "preferDouble",
		"arguments.linePerArgument": false,
		"arrayExpression.linePerElement": false,
		"parameters.linePerParameter": false,
		"conditionalExpression.linePerExpression": false
	},
	"json": {
	},
	"markdown": {
	},
	"markup": {
	},
	"excludes": [
		"**/node_modules",
		"**/*-lock.json"
	],
	"plugins": [
		"npm:@dprint/typescript@0.101.0",
		"npm:@dprint/json@0.26.0",
		"npm:@dprint/markdown@0.29.0",
		"npm:dprint-plugin-markup@0.28.0"
	]
}
