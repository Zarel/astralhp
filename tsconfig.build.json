{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declarationMap": true,
		"inlineSources": true,
		"noEmit": false,
		"noEmitOnError": true,
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"sourceMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "src/components/index.d.ts"]
}
