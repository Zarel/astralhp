---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"script">, "src" | "type"> & {
	src: string;
	/** Embed the bundle in a module script element. */
	inline?: boolean;
	/** @internal Prepared bundle contents. */
	__astrohpContent?: string;
	/** @internal Prepared stylesheets imported by the bundle. */
	__astrohpInlineStyles?: string[];
	/** @internal Filled by AstroHP's build integration. */
	__astrohpStyles?: string[];
};

const {
	src,
	inline = false,
	__astrohpContent,
	__astrohpInlineStyles,
	__astrohpStyles,
	...attributes
} = Astro.props;
if (!__astrohpStyles) {
	throw new Error(
		'Import JS directly from "astrohp/components" and use a literal src',
	);
}
if (inline && __astrohpContent === undefined) {
	throw new Error(
		'Import JS directly from "astrohp/components" and use a literal src',
	);
}
---
{inline ? (
	<>
		{__astrohpInlineStyles?.map(css => (
			<style is:inline nonce={attributes.nonce} set:html={css} />
		))}
		<script
			is:inline
			{...attributes}
			type="module"
			set:html={__astrohpContent}
		></script>
	</>
) : (
	 <>
		 {__astrohpStyles.map(href => <link rel="stylesheet" href={href} />)}
		 <script is:inline {...attributes} type="module" src={src}></script>
	 </>
 )}
