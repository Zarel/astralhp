---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"script">, "src" | "type"> & {
	src: string;
	/** Embed the bundle in a module script element. */
	inline?: boolean;
	/** @internal Prepared bundle contents. */
	__astralhpContent?: string;
	/** @internal Prepared stylesheets imported by the bundle. */
	__astralhpInlineStyles?: string[];
	/** @internal Filled by AstralHP's build integration. */
	__astralhpStyles?: string[];
};

const {
	src,
	inline = false,
	__astralhpContent,
	__astralhpInlineStyles,
	__astralhpStyles,
	...attributes
} = Astro.props;
if (!__astralhpStyles) {
	throw new Error(
		'Import JS directly from "astralhp/components" and use a literal src',
	);
}
if (inline && __astralhpContent === undefined) {
	throw new Error(
		'Import JS directly from "astralhp/components" and use a literal src',
	);
}
---
{inline ? (
	<>
		{__astralhpInlineStyles?.map(css => (
			<style is:inline nonce={attributes.nonce} set:html={css} />
		))}
		<script
			is:inline
			{...attributes}
			type="module"
			set:html={__astralhpContent}
		></script>
	</>
) : (
	 <>
		 {__astralhpStyles.map(href => <link rel="stylesheet" href={href} />)}
		 <script is:inline {...attributes} type="module" src={src}></script>
	 </>
 )}
