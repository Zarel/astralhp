---
import type { HTMLAttributes } from "astro/types";
import { cachebust } from "../cachebuster.js";
import { Webroot } from "../webroot.js";

type Props = Omit<HTMLAttributes<"link">, "href" | "rel"> & {
	src: string;
	/** Embed the stylesheet in a style element. */
	inline?: boolean;
	/** @internal Prepared stylesheet contents. */
	__astralhpContent?: string;
	/** @internal Filled by AstralHP for compiled stylesheets. */
	__astralhpHref?: string;
};

const {
	src,
	inline = false,
	__astralhpContent,
	__astralhpHref,
	...attributes
} = Astro.props;
if (inline && __astralhpContent === undefined) {
	throw new Error(
		'Import CSS directly from "astralhp/components" and use a literal src',
	);
}
const href = inline ? undefined : __astralhpHref ?? cachebust(
	new Webroot({ webroot: import.meta.env.ASTRALHP_WEBROOT }),
	src,
	Astro.url,
);
---
{inline ? <style is:inline {...attributes} set:html={__astralhpContent} /> : (
	 <link {...attributes} rel="stylesheet" href={href} />
 )}
