---
import type { HTMLAttributes } from "astro/types";
import { cachebust } from "../cachebuster.js";
import { Webroot } from "../webroot.js";

type Props = Omit<HTMLAttributes<"link">, "href" | "rel"> & {
	src: string;
	/** Embed the stylesheet in a style element. */
	inline?: boolean;
	/** @internal Prepared stylesheet contents. */
	__astrohpContent?: string;
	/** @internal Filled by AstroHP for compiled stylesheets. */
	__astrohpHref?: string;
};

const { src, inline = false, __astrohpContent, __astrohpHref, ...attributes } =
	Astro.props;
if (inline && __astrohpContent === undefined) {
	throw new Error(
		'Import CSS directly from "astrohp/components" and use a literal src',
	);
}
const href = inline ? undefined : __astrohpHref ?? cachebust(
	new Webroot({ webroot: import.meta.env.ASTROHP_WEBROOT }),
	src,
	Astro.url,
);
---
{inline ? <style is:inline {...attributes} set:html={__astrohpContent} /> : (
	 <link {...attributes} rel="stylesheet" href={href} />
 )}
