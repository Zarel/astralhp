---
import type { HTMLAttributes } from "astro/types";
import { cachebust } from "../cachebuster.js";
import { Webroot } from "../webroot.js";

type Props = Omit<HTMLAttributes<"link">, "href" | "rel"> & {
	src: string;
};

const { src, ...attributes } = Astro.props;
const href = cachebust(
	new Webroot({ webroot: import.meta.env.ASTROHP_WEBROOT }),
	src,
	Astro.url,
);
---
<link {...attributes} rel="stylesheet" href={href} />
