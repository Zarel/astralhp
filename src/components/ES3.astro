---
import type { HTMLAttributes } from "astro/types";
import { cachebustES3Script } from "../cachebuster.js";
import { Webroot } from "../webroot.js";

type Props = Omit<HTMLAttributes<"script">, "src"> & {
	src: string;
	/** @internal Filled by AstralHP for compiled scripts. */
	__astralhpSrc?: string;
};

const { src, __astralhpSrc, ...attributes } = Astro.props;
const resolvedSrc = __astralhpSrc ?? cachebustES3Script(
	new Webroot({ webroot: import.meta.env.ASTRALHP_WEBROOT }),
	src,
	Astro.url,
);
---
<script is:inline {...attributes} src={resolvedSrc}></script>
