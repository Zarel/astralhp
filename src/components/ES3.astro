---
import type { HTMLAttributes } from "astro/types";
import { cachebustScript } from "../cachebuster.js";
import { Webroot } from "../webroot.js";

type Props = Omit<HTMLAttributes<"script">, "src"> & {
	src: string;
	/** @internal Filled by AstroHP for compiled scripts. */
	__astrohpSrc?: string;
};

const { src, __astrohpSrc, ...attributes } = Astro.props;
const resolvedSrc = __astrohpSrc ?? cachebustScript(
	new Webroot({ webroot: import.meta.env.ASTROHP_WEBROOT }),
	src,
	Astro.url,
);
---
<script is:inline {...attributes} src={resolvedSrc}></script>
