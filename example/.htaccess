# ===== BEGIN ASTROHP =====
# Generated by `astrohp apache-proxy`. EDITS WILL BE OVERWRITTEN.

RewriteEngine On

# Don't allow .caches to be served
RewriteCond expr "tolower(unescape(%{THE_REQUEST})) =~ m#\s/+\.caches(?:/|%2f|\?|\s)#"
RewriteRule "^" "-" [R=404,END]

# Don't serve node_modules, dotfiles (except .well-known and .caches), .astro, .ts, or .tsx files
RewriteRule "(?:^|/)node_modules(?:/|$)" "-" [R=404,END,NC]
RewriteRule "(?:^|/)\.(?!well-known(?:/|$)|caches(?:/|$))" "-" [R=404,END,NC]
RewriteRule "\.(?:astro|ts|tsx)$" "-" [R=404,END,NC]

# Serve all other files
RewriteCond "%{REQUEST_FILENAME}" -f
RewriteRule "^" "-" [END]

# Serve built files in .caches/dist/
RewriteCond "%{DOCUMENT_ROOT}/.caches/dist/$1" -f
RewriteRule "^(.+)$" ".caches/dist/$1" [END]

# Remove .html from URLs
RewriteCond "%{DOCUMENT_ROOT}/.caches/dist/index.html" -f
RewriteRule "^$" ".caches/dist/index.html" [END]

RewriteCond "%{DOCUMENT_ROOT}/.caches/dist/$1.html" -f
RewriteRule "^(.+?)/?$" ".caches/dist/$1.html" [END]

RewriteCond "%{DOCUMENT_ROOT}/.caches/dist/$1/index.html" -f
RewriteRule "^(.+?)/?$" ".caches/dist/$1/index.html" [END]

# ===== END ASTROHP =====
