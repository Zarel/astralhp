{
	"name": "astralhp",
	"version": "0.0.1",
	"description": "Astro with PHP-style routing",
	"homepage": "https://github.com/Zarel/astralhp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Zarel/astralhp.git"
	},
	"license": "MIT",
	"author": "Zarel <guangcongluo@gmail.com> (http://guangcongluo.com)",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"default": "./dist/components/index.js"
		},
		"./database": {
			"types": "./dist/database.d.ts",
			"default": "./dist/database.js"
		}
	},
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"components": [
				"dist/components/index.d.ts"
			],
			"database": [
				"dist/database.d.ts"
			]
		}
	},
	"bin": {
		"astralhp": "astralhp"
	},
	"files": [
		"astralhp",
		"dist"
	],
	"scripts": {
		"prebuild": "node scripts/package-assets.mjs clean",
		"build": "tsc -p tsconfig.build.json && node scripts/package-assets.mjs copy && npm run check:astro",
		"check:astro": "astro-check --tsconfig tsconfig.astro.json --minimumSeverity warning --minimumFailingSeverity warning",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"prepare": "npm run build",
		"test": "npm run format:check && npm run typecheck && npm run build && node --test",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "^0.3.2",
		"@astrojs/node": "^11.1.13",
		"@babel/core": "^7.29.13",
		"@babel/plugin-transform-react-jsx": "^7.29.7",
		"@babel/plugin-transform-strict-mode": "^7.29.7",
		"@babel/preset-env": "^7.29.14",
		"@babel/preset-typescript": "^7.29.7",
		"@types/pg": "^8.23.1",
		"astro": "^7.4.12",
		"babel-plugin-remove-import-export": "^1.1.1",
		"css-tree": "^3.2.1",
		"magic-string": "^1.4.5",
		"mysql2": "^3.24.6",
		"pg": "^8.23.1",
		"sass": "^1.108.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@types/babel__core": "^7.20.5",
		"@types/css-tree": "^3.2.0",
		"@types/node": "^24.19.2",
		"dprint": "^0.64.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"engines": {
		"node": ">=22.23.4"
	},
	"allowScripts": {
		"dprint@0.55.2": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
