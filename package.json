{
	"name": "astrohp",
	"version": "0.0.1",
	"description": "Astro with PHP-style routing",
	"license": "MIT",
	"author": "Guangcong Luo <guangcongluo@gmail.com> (http://guangcongluo.com)",
	"type": "module",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"components": ["dist/components/index.d.ts"],
			"database": ["dist/database.d.ts"]
		}
	},
	"bin": {
		"astrohp": "astrohp"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"default": "./dist/components/index.js"
		},
		"./database": {
			"types": "./dist/database.d.ts",
			"default": "./dist/database.js"
		}
	},
	"files": [
		"astrohp",
		"dist"
	],
	"scripts": {
		"prebuild": "node scripts/package-assets.mjs clean",
		"build": "tsc -p tsconfig.build.json && node scripts/package-assets.mjs copy && npm run check:astro",
		"check:astro": "astro-check -- -- --tsconfig tsconfig.astro.json",
		"prepare": "npm run build",
		"test": "npm run typecheck && npm run build && node --test",
		"typecheck": "tsc"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "^0.3.1",
		"@astrojs/node": "^11.0.3",
		"@babel/core": "^7.26.10",
		"@babel/plugin-transform-react-jsx": "^7.25.9",
		"@babel/plugin-transform-strict-mode": "^7.25.9",
		"@babel/preset-env": "^7.26.9",
		"@babel/preset-typescript": "^7.27.0",
		"astro": "^7.1.5",
		"babel-plugin-remove-import-export": "^1.1.1",
		"magic-string": "^1.1.0",
		"mysql2": "^3.23.0",
		"pg": "^8.22.0",
		"@types/pg": "^8.20.0",
		"sass": "^1.108.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.3",
		"dprint": "^0.55.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"allowScripts": {
		"dprint@0.55.2": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
